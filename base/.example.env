# Copy this file to `.env` before running `docker compose up`.

# GitHub personal access token used by the entrypoint to authenticate `gh`.
# Classic PAT minimum scopes: repo, read:org, gist
GITHUB_TOKEN=

# Context7 API key used to automate Context7 startup configuration.
# The entrypoint uses it to:
# - configure the Context7 MCP server for GitHub Copilot CLI
# - run `npx ctx7 setup --claude --api-key ... --yes` for Claude CLI
CONTEXT7_API_KEY=

# Bitbucket CLI credentials used to create the default bb profile automatically.
BITBUCKET_USER=
BITBUCKET_PASSWORD=

# Optional Docker host URL (e.g. tcp://docker-daemon:2375) used by the entrypoint to run `docker login`.
DOCKER_HOST=
#
# Docker registry credentials used by the entrypoint to run `docker login`
# (e.g. against the bundled Docker-in-Docker daemon, see ../examples/docker-compose.yml).
# Leave DOCKER_REGISTRY empty to log in to Docker Hub.
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_REGISTRY=

# Optional path to the JSON config file inside the container.
# Defaults to /root/setup.json (the docker-compose.yml volume mount target).
# Override only if you mount setup.json at a different path.
SETUP_CONFIG=/entrypoint/setup.json

# Optional path to the entrypoint files directory inside the container.
# Defaults to /root/entrypoint (the docker-compose.yml volume mount target).
# Files referenced in setup.json (e.g. claude.global_md) are resolved relative to this directory.
SETUP_FILES_DIR=/entrypoint/files

# Base64-encoded Google Cloud service account JSON key.
# The entrypoint decodes it, exports GOOGLE_APPLICATION_CREDENTIALS,
# and runs `gcloud auth activate-service-account --key-file=...`.
# Generate it with:
# base64 -w 0 path/to/service-account.json
GCLOUD_SERVICE_ACCOUNT_KEY_B64=

# Optional Google Cloud project to select after service-account auth.
GCLOUD_PROJECT_ID=

# AWS CLI credentials used by the entrypoint to configure the default profile.
# Standard long-lived credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Optional session token for temporary credentials.
AWS_SESSION_TOKEN=
#
# Optional region used by the AWS CLI profile.
AWS_DEFAULT_REGION=
#
# Optional profile name. Defaults to `default`.
AWS_PROFILE=default
